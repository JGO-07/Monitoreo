{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "monitoreo.cli",
        "serve",
        "--store",
        "evidencias/almacen",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "portal-live",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "monitoreo.cli",
        "serve",
