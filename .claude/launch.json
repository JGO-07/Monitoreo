        "--scenario-file",
        "escenarios/c1_normal.yaml",
        "--scenario",
        "en_vivo_demo",
        "--store",
        "evidencias/extras/en_vivo",
        "--port",
        "8766"
      ],
      "port": 8766
    }
  ]
